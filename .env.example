# =====================================================================
#  1. INTELIGENCIA ARTIFICIAL (AI COPILOT)
# =====================================================================
OPENAI_API_KEY="sk-proj-..."
ENABLE_DAILY_AGENT_REPORTS="true"

# =====================================================================
#  2. SEGURIDAD Y AUTENTICACIÓN (SUPABASE)
# =====================================================================
SUPABASE_JWT_SECRET="tu_jwt_secret_largo_de_supabase_aqui"
SUPABASE_PROJECT_URL="https://tu-proyecto.supabase.co"
SUPABASE_ISSUER="https://tu-proyecto.supabase.co/auth/v1"
SUPABASE_JWKS_URL="https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json"
ADMIN_SUPABASE_UID="00000000-0000-0000-0000-000000000000"

# =====================================================================
#  3. BASE DE DATOS
# =====================================================================
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres"
DATABASE_RO_URL="postgresql://readonly_user.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# =====================================================================
#  3B. SINCRONIZACIÓN SQL SERVER -> SUPABASE (job externo programado)
